# ★ パターンは必ず先頭 "/" でアンカーすること。
#   スラッシュ無しは .gitignore と同じ規則で全階層にマッチするため、
#   意図しない階層の composer.json / vendor/ などまで配布物から削り落としてしまう
#   （dist 系列では、同梱の inc/plugin-update-checker/ の composer.json と vendor/ を落として
#   PUC が Fatal になる、という形で実際に効く。wporg 系列は PUC を持たないが、規則は同じ）。
/.gitignore      export-ignore
/.gitattributes  export-ignore
/CLAUDE.md       export-ignore
/docs/           export-ignore

/.github/           export-ignore
/composer.json      export-ignore
/composer.lock      export-ignore
/vendor/            export-ignore
/tests/             export-ignore
/.phpcs.xml.dist    export-ignore
